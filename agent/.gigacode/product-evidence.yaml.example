# Copy to ~/.gigacode/product-evidence.yaml; keep this file LOCAL and out of Git.
# Absolute local paths and/or authorised URLs can be used, but must be verified.
# Blank fields mean source not configured. Never write credentials into public YAML.
schema_version: 1
products:
  sample_product:
    specifications:
      local_root: ""
      index_url: ""          # optional approved link; not automatically browsable
    ui_kit:
      package_path: ""       # local .tgz or installed package path
      docs_root: ""          # local docs directory
      docs_url: ""           # optional approved documentation URL
    repositories:
      frontend_root: ""
      backend_root: ""
