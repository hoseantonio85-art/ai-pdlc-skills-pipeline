# Copy to ~/.gigacode/product-evidence.yaml; do not commit filled-in version.
# Paths/URLs are checked on the WORK COMPUTER and need access permissions.
schema_version: 1
products:
  norm:
    specifications:
      local_root: ""
      index_url: ""
    ui_kit:
      package_path: ""
      docs_root: ""
      docs_url: ""
    repositories:
      frontend_root: ""
      backend_root: ""
    design_references:
      local_root: ""
      index_url: ""
    frontend_rules:
      local_root: ""       # approved additional frontend standards/toolchain evidence, optional
      index_url: ""        # allowlisted docs, optional
      toolchain_root: ""   # shared TS/Biome config and package evidence, optional
